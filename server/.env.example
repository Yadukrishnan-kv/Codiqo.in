NODE_ENV=development
PORT=5000

# Local MongoDB instance - connect with MongoDB Compass at this same URL to inspect data
MONGO_URI=mongodb://127.0.0.1:27017/codiqo-dev

# Long random string used to sign admin JWTs
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin of the deployed client (Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Used by `npm run seed:admin` to create/update the superadmin login
ADMIN_NAME=superadmin
ADMIN_EMAIL=admin@codiqo.in
ADMIN_PASSWORD=codiqo.in
